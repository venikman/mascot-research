    },
    {
      "path": "work_examples[].expected_files",
      "type": "array<string>",
      "required": true,
      "meaning": "Expected output filenames for deterministic builds.",
      "example": ["20251012_T-MS_small-parts-done_take01.png"]
    }
  ],
  "cross_field_rules": [
    {
      "rule": "system.episteme.non_acting must be true.",
      "why": "Episteme (Memes.md, Q-A) constrains but never acts.",
      "citations": [":contentReference[oaicite:10]{index=10}"]
    },
    {
      "rule": "templates[].source_refs must reference useful meme IDs.",
      "why": "Grounds each template in canonical habit mechanics.",
      "citations": [":contentReference[oaicite:11]{index=11}"]
    },
    {
      "rule": "Captions in templates[].beats[].caption must obey style.typography.caption_rules.",
      "why": "Keeps meme overlays short and reproducible.",
      "citations": [":contentReference[oaicite:12]{index=12}"]
    },
    {
      "rule": "If any beat includes body_text, export.image must be configured.",
      "why": "Rich text cards require still export compatibility."
    }
  ]
}
