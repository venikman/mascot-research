# OpenAI / GitHub Copilot API Configuration for Auto-Versioning
#
# To use the AI-powered version bump analyzer, you need an OpenAI API key.
# You can use either:
# 1. GitHub Copilot API key (if you have Copilot access)
# 2. OpenAI API key from: https://platform.openai.com/api-keys
#
# Copy this file to .env and add your API key:
#   cp .env.example .env
#
# Then edit .env and add your key below:

# Option 1: OpenAI API Key (recommended)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: GitHub Copilot API Key (alternative)
# GITHUB_COPILOT_API_KEY=your_github_copilot_key_here

# Optional: Specify which GPT model to use
# Options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
# Default: gpt-4o (recommended for best results)
OPENAI_MODEL=gpt-4o

# Note: The auto-version script will fall back to rule-based analysis
# if no API key is provided. The AI analysis is more accurate for
# determining appropriate version bumps.
