# .gitignore for web applications (Node/Deno/TS/React/Next/Vite/Svelte/Angular/Nuxt) + macOS + editors + .NET

# OS / macOS
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
Icon?
__MACOSX/
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment files (keep examples)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample

# Dependencies
node_modules/
bower_components/

# Build outputs
dist/
build/
out/
public/build/
.tmp/
.temp/
tmp/

# Framework/build directories
.next/
.nuxt/
.svelte-kit/
.angular/
.storybook/
storybook-static/

# Tool caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.tsbuildinfo
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_esm/
.rts2_cache_umd/
.turbo/
.nx/cache/
.pnpm-store/

# Yarn v2+ (Berry)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnp.cjs

# Testing artifacts
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
cypress/downloads/
playwright-report/
playwright/.cache/
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Hosting/platform
.vercel/
.netlify/

# Editors/IDEs
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# .NET (useful for F#/.NET web backends)
bin/
obj/
.vs/
TestResult*/
TestResults*/
*.nupkg
*.snupkg
